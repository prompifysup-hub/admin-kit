{
  "name": "prompify-admin-kit",
  "version": "1.0.0",
  "description": "shadcn-admin-kit components (admin + shadcn/ui), packaged for Prompify templates.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./admin/*": {
      "types": "./dist/admin/*.d.ts",
      "default": "./dist/admin/*.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "default": "./dist/ui/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    }
  },
  "peerDependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diacritic": "^0.0.2",
    "inflection": "^3.0.2",
    "lodash": "^4.18.1",
    "lucide-react": "^0.506.0",
    "next-themes": "^0.4.6",
    "query-string": "^9.2.2",
    "ra-core": "^5.15.2",
    "ra-i18n-polyglot": "^5.15.2",
    "ra-language-english": "^5.15.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-error-boundary": "^6.1.0",
    "react-hook-form": "^7.71.1",
    "react-router": "^7.18.3",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prompifysup-hub/admin-kit"
  }
}
